# PLR Champion Software Suite — environment variables
#
# On Vercel: Project → Settings → Environment Variables. Add each one there; never commit real values.
# For local development only: copy this file to ".env.local" and fill it in.
# Everything here is read on the server. None of it is ever sent to the browser.

# ── Private owner access (required) ─────────────────────────────────────────────
# Use ONE of the two password options.
# Option A (recommended): a PBKDF2 hash. Open your deployment's /login page while these are unset and use
#   "Generate hash" — the hash is created in your browser and nothing is sent anywhere.
PLR_OWNER_PASSWORD_HASH=
# Option B: the password itself (minimum 10 characters). Ignored when PLR_OWNER_PASSWORD_HASH is set.
PLR_OWNER_PASSWORD=

# Random string of at least 32 characters used to sign login sessions. The /login setup screen generates one.
# Changing it signs out every session.
PLR_SESSION_SECRET=

# Optional: how long a login lasts, in days (default 7, maximum 30).
PLR_SESSION_DAYS=7
# Optional: change this value (e.g. 1 → 2) to sign out every existing session immediately.
PLR_SESSION_VERSION=1
# Optional: leave unset. Cookies are Secure automatically over HTTPS (always on Vercel).
# Set to "false" only for plain-http local testing on another device.
# PLR_COOKIE_SECURE=

# ── AI (optional) ───────────────────────────────────────────────────────────────
# Without a key every tool still works with templates and manual editing; AI buttons explain how to enable AI.
# With a key, AI requests go browser → this server → Anthropic. The key never reaches the browser.
# Usage is billed by Anthropic to the account that owns the key.
ANTHROPIC_API_KEY=
# Optional: default model (claude-sonnet-5-5, claude-opus-5-5 or claude-haiku-5-5). Default: claude-sonnet-5-5
PLR_AI_MODEL=
# Optional: maximum output tokens per AI request (256–64000, default 8000). Lower = cheaper ceiling per request.
PLR_AI_MAX_OUTPUT_TOKENS=8000
# Optional: set to "true" to switch AI off without removing the key.
PLR_AI_DISABLED=

# Optional: "off" starts every new browser with no sample project and no sample membership libraries
# (a clean copy, as a customer would get). Settings → Data → Remove all sample content does the same for
# a browser that already has samples. Redeploy after changing it.
NEXT_PUBLIC_PLR_SAMPLE_CONTENT=

# ── Automated tests only ────────────────────────────────────────────────────────
# PLR_AI_TEST_PROVIDER=echo makes AI return clearly-labelled "[TEST OUTPUT]" placeholder text so the AI flows
# can be tested without a key. Never set it on a real deployment (it is ignored on Vercel production anyway).
# PLR_AI_TEST_PROVIDER=
